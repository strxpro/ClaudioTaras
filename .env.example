# Step-by-step guide: SETUP.md · live status: /admin/connect (panel → Połączenia)

# Admin panel (/admin)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=at-least-32-random-characters

# Public URL (used for SEO / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase: optional locally (a JSON file store is used), required on Vercel.
# Project Settings → API Keys: Project URL + the service_role key ("Legacy API keys" tab, starts with eyJ)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: e-mails via Resend — new request to you, automatic "thanks" to the client, your replies
RESEND_API_KEY=
NOTIFY_EMAIL=
# Sender on your verified Resend domain, e.g. Claudio Taras <ciao@yourdomain.com>
NOTIFY_FROM=

# Optional: AI for project descriptions in the automatic import (admin → "Dodaj projekt automatycznie").
# Any ONE is enough; without a key the import writes descriptions from built-in templates.
# Free options: Google AI Studio (aistudio.google.com → Get API key), Groq (console.groq.com),
# OpenRouter (openrouter.ai, ":free" models) or a local Ollama (ollama.com, no key needed).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_MODEL=llama3.1
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini   # force one provider

# Optional: token for publishing local projects on a free *.vercel.app domain
# (not needed when the Vercel CLI on this computer is logged in)
VERCEL_TOKEN=

# Optional: Telegram bot (step by step in SETUP.md / TELEGRAM.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=
# Voice notes need GROQ_API_KEY (free, above) or OPENAI_API_KEY
# More free AI for the bot / translations: CEREBRAS_API_KEY, MISTRAL_API_KEY; AI_ORDER=groq,gemini,…

# Free e-mail without a domain: a Make.com scenario (Custom webhook → Gmail "Send an email")
# maps to / subject / html / replyTo from the JSON; the header x-mail-secret must equal MAIL_WEBHOOK_SECRET
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
